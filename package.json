{
  "name": "octoventure",
  "version": "0.2.0",
  "description": "Third-person 3D browser game: a tiny Australian blue-ringed octopus must cross open land back to the sea before it dries out.",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "build:dist": "vite build --outDir dist",
    "deploy:pages": "sh scripts/deploy-pages.sh",
    "preview": "vite preview --outDir play",
    "unit": "node scripts/unit.mjs",
    "bands": "node scripts/bands.mjs",
    "devfly": "node scripts/devfly.mjs",
    "smoke": "node scripts/smoke.mjs",
    "features": "node scripts/features.mjs",
    "placement": "node scripts/placement.mjs",
    "biomes": "node scripts/biomes.mjs",
    "satchel": "node scripts/satchel.mjs",
    "saves": "node scripts/saves.mjs",
    "levels": "node scripts/levels.mjs",
    "perf": "node scripts/perf.mjs",
    "test": "npm run unit && npm run bands && npm run placement && npm run build && npm run smoke && npm run features && npm run satchel && npm run saves && npm run levels && npm run combat && npm run packs && npm run devfly",
    "combat": "node scripts/combat.mjs",
    "packs": "node scripts/packs.mjs",
    "music": "node scripts/music-smoke.mjs",
    "wander": "node scripts/wander.mjs"
  },
  "type": "module",
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "puppeteer-core": "^25.17.0",
    "vite": "^8.3.8",
    "vite-plugin-singlefile": "^2.3.4"
  },
  "private": true
}
